# ??? AutoTD Web Environment Variables ???
# ???뚯씪??蹂듭궗?댁꽌 .env 濡???ν븯怨?媛믪쓣 梨꾩썙二쇱꽭??
# Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini 紐⑤뜽 (湲곕낯媛? gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# TouchDesigner Web Server DAT 二쇱냼
TD_HOST=localhost
TD_PORT=9980

# 諛깆뿏???쒕쾭 ?ы듃
SERVER_PORT=8000

# CORS ?덉슜 異쒖쿂 (媛쒕컻 ??* ?ъ슜)
CORS_ORIGINS=*

# api | local | mcp | no_api
AUTOTD_AGENT_MODE=local
TRELLIS_URL=http://127.0.0.1:7860
COMFYUI_URL=http://127.0.0.1:8188



# Ollama local LLM (free local model)
# Recommended for RTX 4090: qwen3:30b. Safer/faster fallback: qwen3:14b.
AUTOTD_AGENT_MODE=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:30b
OLLAMA_TIMEOUT=120
OLLAMA_NUM_CTX=8192
